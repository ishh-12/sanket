# SANKET backend configuration
# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000

# MongoDB Atlas or local connection string.
# Use MONGODB_URI (canonical). Legacy MONGO_URI is also accepted as a fallback.
MONGODB_URI=

# Shared secret between the Node backend and the Java agent.
# The agent sends this value in the X-Agent-Token header on every request.
# Both sides must use the SAME value. Change from the default before production.
AGENT_API_TOKEN=dev-token-change-in-production

# ── AI diagnosis ──────────────────────────────────────────────────────────────
# SANKET works without AI — local rule-based diagnosis always runs.
# AI augments the diagnosis when available.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Vite dev server runs on 5173 (npm run dev) or 4173 (vite preview).
# Leave empty to allow all origins (development only).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
